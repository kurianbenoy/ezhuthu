    sub ml_na ml_virama ml_dha by ml_na_virama_dha;
    sub ml_na ml_virama ml_ma by ml_na_virama_ma;
    sub ml_na ml_virama ml_rra by ml_na_virama_rra;
    sub ml_pa ml_virama ml_pa by ml_pa_virama_pa;
    sub ml_ba ml_virama ml_ba by ml_ba_virama_ba;
    sub ml_ma ml_virama ml_ma by ml_ma_virama_ma;
    sub ml_ma ml_virama ml_pa by ml_ma_virama_pa;
