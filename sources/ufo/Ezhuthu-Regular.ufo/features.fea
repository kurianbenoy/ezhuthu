@ML_BOTTOM_MARKS = [ml_sign_vocalic_l ml_sign_vocalic_ll];

lookup zwj_chillus {
    lookupflag 0;
    ;
    sub ml_na ml_virama zwj by ml_chillu_n;
    sub ml_ra ml_virama zwj by ml_chillu_rr;
    sub ml_la ml_virama zwj by ml_chillu_l;
    sub ml_lla ml_virama zwj by ml_chillu_ll;
    sub ml_nna ml_virama zwj by ml_chillu_nn;
    sub ml_llla ml_virama zwj by ml_chillu_lll;
    sub ml_ka ml_virama zwj by ml_chillu_k;
} zwj_chillus;

lookup conditional_stack_lookup {
    lookupflag 0;
    ;
    sub ml_sa ml_virama ml_ta by ml_sa_virama_ta;
    sub ml_ssa ml_virama ml_tta by ml_ssa_virama_tta;
} conditional_stack_lookup;

lookup akhn_conjunctsDFLT_dflt_Substitution_4 {
    lookupflag 0;
    ;
    sub ml_ka ml_virama ml_ka by ml_ka_virama_ka;
    sub ml_ka ml_virama ml_ssa by ml_ka_virama_ssa;
    sub ml_ga ml_virama ml_ga by ml_ga_virama_ga;
    sub ml_nga ml_virama ml_nga by ml_nga_virama_nga;
