    sub ml_virama_ra ml_sha by ml_sha_virama_ra;
    sub ml_virama_ra ml_sa by ml_sa_virama_ra;
    sub ml_virama_ra ml_sa_virama_ta by ml_sa_virama_ta_virama_ra;
    sub ml_virama_ra ml_ha by ml_ha_virama_ra;
    sub ml_virama_ra ml_ssa by ml_ssa_virama_ra;
} pres_reph;

