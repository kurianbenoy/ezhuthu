    sub ml_sa ml_virama ml_rra ml_virama ml_rra by ml_sa_virama_rra_virama_rra;
    sub ml_sa ml_virama ml_tha by ml_sa_virama_tha;
    sub ml_lla ml_virama ml_lla by ml_lla_virama_lla;
    sub ml_rra ml_virama ml_rra by ml_rra_virama_rra;
} akhn_conjunctsDFLT_dflt_Substitution_4;

lookup akhn_conjunctsDFLT_dflt_Chaining_1 {
    lookupflag 0;
    ;
    ignore sub ml_sa' ml_virama' ml_ta' ml_virama ml_ta;
    sub ml_sa' lookup conditional_stack_lookup ml_virama' ml_ta';
    ignore sub ml_ssa' ml_virama' ml_tta' ml_virama ml_tta;
    sub ml_ssa' lookup conditional_stack_lookup ml_virama' ml_tta';
} akhn_conjunctsDFLT_dflt_Chaining_1;

lookup cons_la {
    lookupflag 0;
    ;
    sub ml_ka ml_virama ml_la by ml_ka_virama_la;
    sub ml_ga ml_virama ml_la by ml_ga_virama_la;
    sub ml_ta ml_virama ml_la by ml_ta_virama_la;
    sub ml_pa ml_virama ml_la by ml_pa_virama_la;
    sub ml_pha ml_virama ml_la by ml_pha_virama_la;
    sub ml_ba ml_virama ml_la by ml_ba_virama_la;
    sub ml_ma ml_virama ml_la by ml_ma_virama_la;
    sub ml_va ml_virama ml_la by ml_va_virama_la;
    sub ml_sa ml_virama ml_la by ml_sa_virama_la;
    sub ml_sha ml_virama ml_la by ml_sha_virama_la;
    sub ml_ha ml_virama ml_la by ml_ha_virama_la;
} cons_la;

lookup cons_signs {
    lookupflag 0;
    ;
    sub ml_virama ml_ya by ml_virama_ya;
    sub ml_virama ml_va by ml_virama_va;
} cons_signs;

lookup split_cons_signs {
    lookupflag 0;
    ;
    sub ml_virama_ya by ml_virama ml_ya;
    sub ml_virama_va by ml_virama ml_va;
} split_cons_signs;

lookup cons_signs_fix_order {
    lookupflag 0;
    ;
    sub ml_ya ml_virama_ra' lookup split_cons_signs;
    sub ml_virama_ya ml_virama_ra' lookup split_cons_signs;
    sub ml_virama_va ml_virama_ra' lookup split_cons_signs;
} cons_signs_fix_order;

lookup pref_reph {
    lookupflag 0;
    ;
    sub ml_virama ml_ra by ml_virama_ra;
} pref_reph;

lookup pres_reph {
    lookupflag 0;
